# Конфигурация тестового стенда AIWA на Hetzner.
#
# Отличия от deploy/i167 продиктованы площадкой: из Германии Telegram и
# OpenRouter доступны напрямую, поэтому здесь нет ни релея на :8443, ни
# SSH-туннеля на :14443, ни российского trust-бандла. Секретов тут нет —
# токен приходит systemd-credential'ом, ключи провайдеров лежат в
# secrets/providers.env.

AIWA_DB=/srv/aiwa-test/data/aiwa.db
AIWA_VERSION=hetzner-test
AIWA_JOURNAL_V2=1

# Caddy живёт в контейнере сети bizzy-radio_default, поэтому лупбэк хоста ему
# не виден — слушаем docker-гейтвей. Адрес приватный и снаружи не
# маршрутизируется. Если стек bizzy-radio пересоздадут, гейтвей может
# смениться: проверить `docker network inspect bizzy-radio_default`.
AIWA_BIND_HOST=172.19.0.1
PORT=9910
AIWA_HTTP_BACKLOG=2048
AIWA_TZ=Europe/Moscow

AIWA_WEBAPP_URL=https://aiwa-167.233.103.46.sslip.io
AIWA_ALLOWED_ORIGINS=https://aiwa-167.233.103.46.sslip.io

# Telegram и OpenRouter — напрямую, без релеев.
AIWA_TELEGRAM_MAX_RATE=28
AIWA_TELEGRAM_RATE_RETRIES=2

AIWA_ALLOW_INSECURE_LLM_HTTP=0
AIWA_MODEL_PROBE_SEC=300
AIWA_PROVIDER=openrouter
AIWA_PROVIDER_FALLBACKS=none
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_ZDR=1
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_PROVIDER_ONLY=
OPENROUTER_PROVIDER_SORT=latency
OPENROUTER_ALLOW_FALLBACKS=1
OPENROUTER_REQUIRE_PARAMETERS=1
OPENROUTER_VISION_PROVIDER_SORT=throughput

AIWA_TRACTION_URL=
AIWA_PROACTIVE=1
AIWA_PROACTIVE_SHADOW=0

# Пулы урезаны против i167: там коробка просторнее, здесь 3.7 ГБ на всех и
# swap уже занят наполовину. Стенд для одного-двух тестировщиков.
AIWA_EXECUTOR_THREADS=16
AIWA_LLM_CONCURRENCY=4
AIWA_TODAY_CONCURRENCY=3
AIWA_CHAT_RESERVED_SLOTS=1
AIWA_TODAY_QUEUE_MAX=300
AIWA_FOOD_VISION_CONCURRENCY=3
AIWA_FOOD_VISION_QUEUE_MAX=60
AIWA_FOOD_VISION_WAIT_SECONDS=60
AIWA_BROADCAST_WORKERS=3
AIWA_FOOD_WORKERS=2

AIWA_FOOD_ASSET_RESOLVER=1
AIWA_FOOD_SECTION_REFRESH=1
AIWA_SECTION_PENDING_MAX=96
AIWA_SECTION_RETRY_AFTER_MS=8000
AIWA_FOOD_DYNAMIC_SECTION=1
AIWA_FOOD_DYNAMIC_SECTION_PERCENT=100
AIWA_FOOD_ASSET_GENERATION=0
AIWA_FOOD_ASSET_DIR=/srv/aiwa-test/data/food-assets
AIWA_FOOD_ASSET_PUBLIC_BASE=/generated-food

AIWA_AI_JOB_MAX_ATTEMPTS=3
AIWA_SYNTHETIC_USER_ID_MIN=790000000000

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
MPLCONFIGDIR=/tmp/matplotlib

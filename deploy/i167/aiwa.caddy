# AIWA production Mini App. Единственный публичный production hostname.
app.aiwa-wellness.app {
	encode zstd gzip

	# Манифест «название -> файл» — изменяемые данные, и immutable ему не
	# место: после замены каталога у клиентов оставался старый манифест,
	# который ссылался на удалённые файлы, и картинки ломались. Перезагрузка
	# не помогала — immutable запрещает браузеру переспрашивать.
	handle /assets/*/manifest.json {
		root * /srv/aiwa/current/webapp2
		header Cache-Control "no-cache"
		file_server
	}

	# Сами картинки адресуются по содержимому: имя меняется вместе с файлом,
	# поэтому вечный кэш для них корректен.
	handle /assets/* {
		root * /srv/aiwa/current/webapp2
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:9920
	}
}

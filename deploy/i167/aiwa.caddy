# AIWA production. До появления собственного домена работает на временном
# candidate-имени; при подключении домена меняется только hostname этой
# строки (и env AIWA_WEBAPP_URL/AIWA_ALLOWED_ORIGINS).
aiwa-candidate-167.158-160-163-167.sslip.io {
	encode zstd gzip

	handle /assets/* {
		root * /srv/aiwa/current/webapp2
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:9920
	}
}

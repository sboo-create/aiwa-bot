[Unit]
Description=AIWA production bot and web service
After=network-online.target aiwa-relay-client.service haproxy.service
Wants=network-online.target aiwa-relay-client.service haproxy.service

[Service]
Type=simple
User=aiwa
Group=aiwa
WorkingDirectory=/srv/aiwa/current
EnvironmentFile=/srv/aiwa/config/app.env
EnvironmentFile=-/srv/aiwa/secrets/providers.env
LoadCredential=bot_token:/srv/aiwa/secrets/bot-token
Environment=BOT_TOKEN_FILE=/run/credentials/aiwa.service/bot_token
ExecStart=/srv/aiwa/venv/bin/python aiwa_bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

CPUQuota=200%
MemoryMax=4G
TasksMax=512
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/aiwa/data
BindReadOnlyPaths=/srv/aiwa/config/hosts:/etc/hosts

[Install]
WantedBy=multi-user.target

aiwa-staging-167.158-160-163-167.sslip.io {
	encode zstd gzip

	# Раздаём из каталога релиза, как на проде. Раньше здесь был отдельный
	# public-current, который деплой не обновлял: staging тестировал старые
	# ассеты при новом index.html.
	#
	# Манифест «название -> файл» — изменяемые данные, и immutable ему не
	# место: после замены каталога у клиентов оставался старый манифест со
	# ссылками на удалённые файлы, и картинки ломались.
	handle /assets/*/manifest.json {
		root * /srv/aiwa-staging/current/webapp2
		header Cache-Control "no-cache"
		file_server
	}

	handle /assets/* {
		root * /srv/aiwa-staging/current/webapp2
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:9910
	}
}

[Unit]
Description=AIWA isolated staging bot and web service
After=network-online.target gigatool-tg-tunnel.service aiwa-openrouter-tunnel.service
Wants=network-online.target gigatool-tg-tunnel.service aiwa-openrouter-tunnel.service

[Service]
Type=simple
User=aiwa-staging
Group=aiwa-staging
WorkingDirectory=/srv/aiwa-staging/current
EnvironmentFile=/srv/aiwa-staging/config/app.env
EnvironmentFile=-/srv/aiwa-staging/secrets/providers.env
LoadCredential=bot_token:/srv/aiwa-staging/secrets/bot-token
Environment=BOT_TOKEN_FILE=/run/credentials/aiwa-staging.service/bot_token
ExecStart=/srv/aiwa-staging/venv/bin/python aiwa_bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077

CPUQuota=200%
MemoryMax=4G
TasksMax=512
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/aiwa-staging/data
BindReadOnlyPaths=/srv/aiwa-staging/config/hosts:/etc/hosts

[Install]
WantedBy=multi-user.target

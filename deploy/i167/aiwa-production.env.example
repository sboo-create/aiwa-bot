# Production env для /srv/aiwa/config/app.env на i167.
# app.aiwa-wellness.app — канонический Mini App URL. Railway compatibility
# proxy отключён 2026-08-05 и больше не входит в allowed origins.
AIWA_DB=/srv/aiwa/data/aiwa.db
AIWA_VERSION=2026-08-05-production
AIWA_JOURNAL_V2=1
AIWA_BIND_HOST=127.0.0.1
PORT=9920
AIWA_HTTP_BACKLOG=2048
AIWA_TZ=Europe/Moscow
AIWA_WEBAPP_URL=https://app.aiwa-wellness.app
AIWA_ALLOWED_ORIGINS=https://app.aiwa-wellness.app
# Egress через relay: HAProxy 8443/14443 -> stunnel client -> relay (i196).
# Валидатор приложения допускает только порты 443/8443 для Telegram origin.
AIWA_TELEGRAM_API_ORIGIN=https://api.telegram.org:8443
AIWA_TELEGRAM_BOT_BASE_URL=https://api.telegram.org:8443/bot
AIWA_TELEGRAM_FILE_BASE_URL=https://api.telegram.org:8443/file/bot
AIWA_TELEGRAM_MAX_RATE=28
AIWA_TELEGRAM_RATE_RETRIES=2
AIWA_ALLOW_INSECURE_LLM_HTTP=0
AIWA_MODEL_PROBE_SEC=0
AIWA_ALERT_LLM_MIN_CALLS=5
AIWA_PROVIDER=openrouter
AIWA_PROVIDER_FALLBACKS=none
OPENROUTER_BASE_URL=https://openrouter.ai:14443/api/v1
# ВСЕ обращения к openrouter.ai идут через relay-порт 14443. Хост
# openrouter.ai в service-specific hosts указывает на 127.0.0.1, а на :443
# там wildcard-Caddy — без порта запрос молча не уходит наружу (инцидент
# 31.07: генерация картинок еды встала на переезде и никто не заметил).
AIWA_FOOD_IMAGE_API_URL=https://openrouter.ai:14443/api/v1/images
AIWA_FOOD_IMAGE_VALIDATION_API_URL=https://openrouter.ai:14443/api/v1/chat/completions
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_ZDR=1
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_PROVIDER_SORT=latency
OPENROUTER_ALLOW_FALLBACKS=1
OPENROUTER_REQUIRE_PARAMETERS=1
AIWA_PROACTIVE=0
AIWA_EXECUTOR_THREADS=64
AIWA_LLM_CONCURRENCY=10
AIWA_TODAY_CONCURRENCY=8
AIWA_CHAT_RESERVED_SLOTS=2
AIWA_TODAY_QUEUE_MAX=1500
AIWA_FOOD_VISION_CONCURRENCY=8
AIWA_FOOD_VISION_QUEUE_MAX=200
AIWA_FOOD_VISION_WAIT_SECONDS=60
AIWA_FOOD_ASSET_GENERATION=0
AIWA_FOOD_ASSET_DIR=/srv/aiwa/data/food-assets
AIWA_FOOD_ASSET_PUBLIC_BASE=/generated-food
AIWA_BROADCAST_WORKERS=10
AIWA_FOOD_WORKERS=3
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
MPLCONFIGDIR=/tmp/matplotlib
GROQ_BASE_URL=https://api.groq.com:9443/openai/v1

# Скопируй в .env и заполни своими значениями.
BOT_TOKEN=сюда_токен_от_BotFather
AIWA_TZ=Europe/Moscow
# Telegram chat id для служебных команд и алертов бота.
AIWA_ADMIN=сюда_Telegram_chat_id_администратора
AIWA_ANALYTICS_SALT=сюда_отдельная_случайная_строка_минимум_32_символа
# Внешний Disrupt Analytics. Доставка идёт через локальный durable outbox.
# AIWA_TRACTION_URL=https://stats.multitool.works/p/aiwa/events
# AIWA_TRACTION_TOKEN=сюда_write_only_token_модуля_aiwa
# Подпись Telegram Mini App действует сутки. Можно уменьшить после проверки UX.
AIWA_INIT_DATA_MAX_AGE_SECONDS=86400
# Только если mini app размещён на другом origin; через запятую, без wildcard.
# AIWA_ALLOWED_ORIGINS=https://miniapp.example.com

# === LLM-провайдер ===
# Вариант 1 (по умолчанию) — GigaChat (Сбер):
AIWA_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=сюда_Authorization_key_из_кабинета_GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# TLS проверяется по умолчанию. Для собственного CA укажи путь к PEM вместо отключения проверки.
# GIGACHAT_CA_BUNDLE_FILE=/path/to/ca.pem

# Вариант 2 — LiteLLM-прокси (раскомментируй и заполни, если используешь его):
# AIWA_PROVIDER=litellm
# LITELLM_URL=https://...
# LITELLM_KEY=...
# LITELLM_MODEL=...
# LITELLM_CA_BUNDLE_FILE=/path/to/ca.pem

# Вариант 3 — OpenRouter. Endpoint подставляется только при наличии ключа:
# AIWA_PROVIDER=openrouter
# AIWA_PROVIDER_FALLBACKS=none
# OPENROUTER_API_KEY=...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_MODEL=organization/model-slug  # старое имя, поддерживается как alias для text
# OPENROUTER_PROVIDER_IGNORE=novita
# OPENROUTER_ALLOW_FALLBACKS=1
# OPENROUTER_REQUIRE_PARAMETERS=1
# OPENROUTER_PROVIDER_SORT=throughput  # optional: price, throughput или latency
# Vision использует отдельную маршрутизацию: text-only allowlist сюда не наследуется.
# OPENROUTER_VISION_PROVIDER_ONLY=google-vertex
# OPENROUTER_VISION_PROVIDER_SORT=throughput
# OPENROUTER_VISION_ALLOW_FALLBACKS=1
# Для чувствительных данных эти безопасные значения включены по умолчанию.
# OPENROUTER_ZDR=1
# OPENROUTER_DATA_COLLECTION=deny
# HTTP без TLS блокируется, поскольку раскрывает ключ и данные. Только для изолированного теста:
# AIWA_ALLOW_INSECURE_LLM_HTTP=0
# OPENROUTER_HTTP_REFERER=https://your-product.example
# OPENROUTER_APP_TITLE=AIWA

# === Семантическая запись дневника ===
# Новый LLM-маршрут создания и безопасного исправления записей. Сначала включай
# на staging или только для перечисленных Telegram chat_id.
AIWA_JOURNAL_V2=0
# AIWA_JOURNAL_V2_IDS=123456789,987654321
# Быстрая отдельная модель для классификации и разбора состава еды. Если не
# задана, используется основная текстовая модель Айвы.
# AIWA_JOURNAL_MODEL=openrouter/google/gemini-3.1-flash-lite
AIWA_JOURNAL_ROUTE_TIMEOUT_SECONDS=15
AIWA_JOURNAL_HTTP_TIMEOUT_SECONDS=12

# Одновременно разбирается ограниченное число фотографий.
AIWA_FOOD_VISION_CONCURRENCY=3
AIWA_FOOD_VISION_QUEUE_MAX=50
AIWA_FOOD_VISION_WAIT_SECONDS=60

# === Картинки питания и динамическая секция ===
# Быстрый in-memory резолвер 105 существующих картинок. Не делает сеть/LLM/БД
# в request path; 0 — мгновенный аварийный возврат к клиентскому fallback.
AIWA_FOOD_ASSET_RESOLVER=1
# После быстрого fallback клиент делает не более трёх refresh с server delay
# и jitter. 0 полностью запрещает food-refresh, фоновая задача при этом может
# спокойно наполнить кэш для следующего открытия.
AIWA_FOOD_SECTION_REFRESH=1
AIWA_SECTION_PENDING_MAX=96
AIWA_SECTION_RETRY_AFTER_MS=8000
# Новый cache namespace с одним структурированным вызовом:
# summary + menu + suggestions. На пиковый день оставить 0, затем включить
# сначала на staging и в production после спада нагрузки.
AIWA_FOOD_DYNAMIC_SECTION=0
# Генератор неизвестных блюд отделён от request/LLM workers и по умолчанию
# выключен. Для включения обязательны persistent каталог и Images endpoint.
AIWA_FOOD_ASSET_GENERATION=0
AIWA_FOOD_ASSET_QUEUE_MAX=256
AIWA_FOOD_ASSET_WORKERS=1
AIWA_FOOD_ASSET_DAILY_MAX=40
AIWA_FOOD_ASSET_MAX_ATTEMPTS=3
AIWA_FOOD_ASSET_DIR=/data/food-assets
AIWA_FOOD_ASSET_PUBLIC_BASE=/generated-food
# OpenAI-compatible Images endpoint должен возвращать data[0].b64_json.
# AIWA_FOOD_IMAGE_API_URL=https://provider.example/v1/images/generations
# AIWA_FOOD_IMAGE_API_KEY=...
# AIWA_FOOD_IMAGE_MODEL=...
# AIWA_FOOD_IMAGE_TIMEOUT_SECONDS=75

# === Голос: распознавание через Groq Whisper ===
# Только для голосовых сообщений. Без ключа голос игнорируется, текст работает.
GROQ_API_KEY=сюда_ключ_groq_gsk_...

# Распознавание голоса: salute | groq | auto (по умолчанию auto).
# auto = сначала SaluteSpeech (голосовые Telegram, формат ogg/opus), для webm из мини-аппа и при сбое — Groq.
AIWA_STT=auto
# SBER_SALUTE_AUTH_KEY — это ТОЛЬКО секрет; логин отдельно (по умолчанию gigacons)
SBER_SALUTE_AUTH_KEY=сюда_секрет_speech.giga.chat
# SBER_SALUTE_CLIENT=gigacons
SBER_SALUTE_RECOGNITION_MODEL=voice_messaging
# URL по умолчанию — speech.giga.chat. Для smartspeech.sber.ru задай эти три и SALUTE_SPEECH_SCOPE:
# SBER_SALUTE_OAUTH_URL=https://speech.giga.chat/v1/token
# SBER_SALUTE_RECOGNIZE_URL=https://speech.giga.chat/rest/v1/speech:recognize
# SBER_SALUTE_SYNTH_URL=https://speech.giga.chat/rest/v1/text:synthesize

# Ответ голосом на голосовое сообщение (текст приходит всегда).
# По умолчанию выключено: включай только после проверки совпадения текста и TTS.
AIWA_VOICE_REPLY=0
AIWA_TTS_VOICE=erm
AIWA_TTS_MAXCHARS=3500
# Голосовые чанки генерируются параллельно, отправляются по порядку.
# personal ограничивает общий параллелизм пятью потоками, legal — десятью.
AIWA_SALUTE_ACCOUNT_TYPE=personal
AIWA_TTS_PROVIDER_CONCURRENCY=3
# Live load-test 2026-07-24 прошёл без ошибок до 5 потоков; 3 — рабочее значение с запасом.
AIWA_TTS_PARALLELISM=3

# Утренняя сводка отправляется ровно в выбранное пользователем время.
# Тяжёлая генерация начинается заранее и распределяется по этому окну:
AIWA_SUMMARY_PREPARE_MIN=10
AIWA_SUMMARY_PREPARE_SPREAD_MIN=20
# Быстрый sender для пика в выбранную минуту.
AIWA_BROADCAST_WORKERS=10
AIWA_BROADCAST_DELAY=0.05
AIWA_PUSH_CLAIM_TTL_SEC=900

# Доля AI-ответов с кнопками «Полезно / Не помогло»: 0.20 = примерно каждый пятый.
AIWA_FEEDBACK_SAMPLE_RATE=0.20
